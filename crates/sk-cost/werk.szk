[flow] guid=1S7bUW0010080700000001 name="Neuen Stein mit Preis anlegen" ask="Ein Stein für Mauerwerk, mit Preis je m²." kind=admin
[flow] guid=1S7bUW0010080700000002 name="Händlerpreis für dieses Haus eintragen" ask="Der Preis gilt nur für dieses Haus." kind=user
[flow] guid=1S7bUW0010080700000003 name="Verrechnungslohn für das neue Jahr setzen" ask="Gilt für alle neuen Häuser." kind=admin
[flowstep] guid=1S7bUW0010080800000001 flow=1S7bUW0010080700000001 nr=1 step=ask key=baustoff text="Aus welchem Baustoff?" type=pick:material
[flowstep] guid=1S7bUW0010080800000002 flow=1S7bUW0010080700000001 nr=2 step=ask key=dicke text="Wie dick ist der Stein (mm)?" type=mm min=50 max=500
[flowstep] guid=1S7bUW0010080800000003 flow=1S7bUW0010080700000001 nr=3 step=ask key=preis text="Was kostet er netto?" type=money min=0.01 max=1000 per="m2 m3:{dicke}"
[flowstep] guid=1S7bUW0010080800000004 flow=1S7bUW0010080700000001 nr=4 step=ask key=name text="Name" type=text preset="{baustoff}-Stein d={dicke}mm"
[flowstep] guid=1S7bUW0010080800000005 flow=1S7bUW0010080700000001 nr=5 step=ask key=quelle text="Quelle" type=text optional=1 hint="z. B. Händler Müller 10/2026"
[flowstep] guid=1S7bUW0010080800000006 flow=1S7bUW0010080700000001 nr=6 step=op op=artikel_anlegen args="baustoff={baustoff} name={name} dicke={dicke} einheit=m2 preis={preis} quelle={quelle}"
[flowstep] guid=1S7bUW0010080800000007 flow=1S7bUW0010080700000001 nr=7 step=done text="Stein {name} mit {preis} €/m² angelegt."
