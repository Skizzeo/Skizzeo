[extdef] key=werk.bodenplatte version=1 text="SZB 0\n# Beispiel der Skizzeo-Bauteil-Werkbank 0.5\n[bauteil] key=werk.bodenplatte name=\"Bodenplatte\" mehrzahl=\"Bodenplatten\" genus=f praefix=BP art=groundslab aussen=ja ifc=IfcSlab.BASESLAB kg=322 gewerk=18331 version=1 autor=\"Skizzeo\" beschreibung=\"Rechteckige Stahlbeton-Bodenplatte, Oberkante auf UK Geschoss\"\n[bedienung] gruppe=tragwerk einfuegen=rechteck breite=b tiefe=t drehen=ja\n[hoehe] ab=uk versatz=\"-d\"\n[param] key=b name=\"Breite\" einheit=mm wert=6000 min=1000 max=30000 zeichnen=ja hilfe=\"Seite in Richtung X, aus der ersten gezogenen Seite.\"\n[param] key=t name=\"Tiefe\" einheit=mm wert=4000 min=1000 max=30000 zeichnen=ja hilfe=\"Seite in Richtung Y, aus der zweiten gezogenen Seite.\"\n[param] key=d name=\"Dicke\" einheit=mm wert=200 min=150 max=400 gruppe=\"Maße\" hilfe=\"Plattendicke, Oberkante liegt auf UK Geschoss.\"\n[typ] key=bp20 name=\"Bodenplatte 20 cm\" werte=\"d=200\" standard=ja\n[typ] key=bp25 name=\"Bodenplatte 25 cm\" werte=\"d=250\"\n[koerper] form=quader baustoff=stahlbeton teil=\"Platte\" funktion=loadbearing x=0 y=0 z=0 b=b t=t h=d\n[menge] key=beton name=\"Beton C25/30\" einheit=m3 formel=\"volumen(stahlbeton)\" baustoff=stahlbeton bezug=volume leistung=1S7bUW0010080200000001 dicke=d anzeigen=ja\n[menge] key=rand name=\"Randschalung\" einheit=m formel=\"2*(b+t)/1000\" bezug=perimeter leistung=1S7bUW0010080200000005\n[menge] key=stahl name=\"Betonstahl B500\" einheit=t formel=\"volumen(stahlbeton)*0.08\" bezug=steel leistung=1S7bUW0010080200000006\n[notiz] art=stand text=\"Beispiel der Werkbank: Bodenplatte als Rechteck mit Werks-Leistungen\"\n[notiz] art=offen text=\"Bewehrungsgrad 80 kg/m³ mit Statik abstimmen\"\n"
[extdef] key=werk.stabgelaender version=1 text="SZB 0\n# Beispiel der Skizzeo-Bauteil-Werkbank 0.5\n[bauteil] key=werk.stabgelaender name=\"Stabgeländer\" mehrzahl=\"Stabgeländer\" genus=n praefix=GL art=railing aussen=ja ifc=IfcRailing.GUARDRAIL kg=359 gewerk=18360 version=1 autor=\"Skizzeo\" beschreibung=\"Stahlgeländer mit Pfosten, Handlauf, senkrechten Füllstäben und Fußleiste, auf Fußboden befestigt\"\n[bedienung] gruppe=treppen_gelaender einfuegen=linie laenge=l drehen=nein\n[hoehe] ab=uk versatz=0\n[param] key=l name=\"Länge\" einheit=mm wert=3000 min=500 max=12000 zeichnen=ja hilfe=\"Länge des Geländers entlang der gezeichneten Linie.\"\n[param] key=hg name=\"Höhe\" einheit=mm wert=1000 min=900 max=1200 zeichnen=ja hilfe=\"Oberkante Handlauf über Fußboden.\"\n[param] key=fe name=\"Feldbreite\" einheit=mm wert=1200 min=600 max=2000 gruppe=\"Maße\" hilfe=\"Größter Abstand zwischen zwei Pfosten.\"\n[param] key=fu name=\"Füllung\" einheit=- wert=1 wahl=\"0:ohne|1:Stäbe\" gruppe=\"Ausführung\" hilfe=\"Senkrechte Füllstäbe mit höchstens 12 cm Lichtmaß.\"\n[param] key=fl name=\"Fußleiste\" einheit=- wert=1 janein=ja gruppe=\"Ausführung\" hilfe=\"Flachstahl am unteren Rand.\"\n[param] key=fh name=\"Fußleistenhöhe\" einheit=mm wert=100 min=50 max=200 gruppe=\"Ausführung\" sichtbar=fl hilfe=\"Höhe der Fußleiste.\"\n[typ] key=g100 name=\"Geländer 1,00 m\" werte=\"hg=1000; fu=1; fl=1\" standard=ja\n[typ] key=g110 name=\"Geländer 1,10 m\" werte=\"hg=1100; fu=1; fl=1\"\n[typ] key=g100o name=\"Geländer 1,00 m ohne Stäbe\" werte=\"hg=1000; fu=0; fl=0\"\n[baustoff] key=stahl_s235 name=\"Baustahl S235, verzinkt\" kategorie=metal rohdichte=7850 farbe=7d8288 gewerk=18360 euroklasse=A1 c=450 quelle=\"DIN EN 10025-2 und DIN EN ISO 10456, Tabellenwerte\" stand=10/2026 sicherheit=belegt\n[wert] key=np formel=\"auf(l/fe)+1\"\n[wert] key=ns formel=\"wenn(fu,auf((l-80)/136)-1,0)\"\n[koerper] form=quader baustoff=stahl_s235 teil=\"Pfosten\" funktion=loadbearing anzahl=np x=\"i*(l-40)/(n-1)\" y=-20 z=0 b=40 t=40 h=\"hg-40\"\n[koerper] form=quader baustoff=stahl_s235 teil=\"Handlauf\" funktion=loadbearing x=0 y=-25 z=\"hg-40\" b=l t=50 h=40\n[koerper] form=zylinder baustoff=stahl_s235 teil=\"Füllstäbe\" funktion=finish wenn=ns anzahl=ns x=\"40+(i+1)*(l-80)/(n+1)\" y=-30 z=\"wenn(fl,fh,100)\" r=8 h=\"hg-40-wenn(fl,fh,100)\"\n[koerper] form=quader baustoff=stahl_s235 teil=\"Fußleiste\" funktion=finish wenn=fl x=40 y=-5 z=0 b=\"l-80\" t=10 h=fh\n[artikel] key=stahl_gelaender name=\"Geländerstahl S235 feuerverzinkt, Rohr und Flachstahl\" baustoff=stahl_s235 einheit=kg preis=3.2 stand=10/2026 quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[leistung] key=gelaender kurztext=\"Stabgeländer Stahl verzinkt, H 1,0 m, Füllstäbe, auf Beton gedübelt\" langtext=\"Stabgeländer aus Baustahl S235, feuerverzinkt, Pfosten 40/40 mm, Handlauf 50/40 mm, senkrechte Füllstäbe d=16 mm mit höchstens 12 cm Lichtmaß, Fußleiste Flachstahl, Pfosten auf Beton gedübelt, einschließlich Werkstattzeichnung, Lieferung und Montage.\" gewerk=18360 einheit=m bezug=length stunden=1.5 stoffe=\"stahl_gelaender:22\" funktion=loadbearing quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[menge] key=lg name=\"Geländer\" einheit=m formel=\"l/1000\" bezug=length leistung=gelaender anzeigen=ja\n[menge] key=st name=\"Pfosten\" einheit=stk formel=np\n[notiz] art=stand text=\"Beispiel der Werkbank: Geländer als Linie mit Wahl, Schalter und Typen\"\n[notiz] art=offen text=\"Stahlpreis und Aufwand recherchieren, Gewicht je m aus dem Modell statt 22 kg/m\"\n"
[extdef] key=werk.streifenfundament version=1 text="SZB 0\n# Beispiel der Skizzeo-Bauteil-Werkbank 0.5\n[bauteil] key=werk.streifenfundament name=\"Streifenfundament\" mehrzahl=\"Streifenfundamente\" genus=n praefix=SF art=stripfooting aussen=ja ifc=IfcFooting.STRIP_FOOTING kg=322 gewerk=18331 version=1 autor=\"Skizzeo\" beschreibung=\"Streifenfundament unter Wänden, Oberkante auf UK Geschoss, erdgeschalt\"\n[bedienung] gruppe=tragwerk einfuegen=linie laenge=l drehen=nein\n[hoehe] ab=uk versatz=\"-h\"\n[param] key=l name=\"Länge\" einheit=mm wert=5000 min=500 max=30000 zeichnen=ja hilfe=\"Länge entlang der gezeichneten Linie.\"\n[param] key=b name=\"Breite\" einheit=mm wert=500 min=300 max=1200 gruppe=\"Maße\" zeichnen=ja hilfe=\"Breite quer zur Linie, mittig unter der Linie.\"\n[param] key=h name=\"Höhe\" einheit=mm wert=800 min=400 max=1500 gruppe=\"Maße\" hilfe=\"Höhe von der Sohle bis UK Geschoss, frostfrei mindestens 800 mm.\"\n[typ] key=sf5080 name=\"Fundament 50/80\" werte=\"b=500; h=800\" standard=ja\n[typ] key=sf6080 name=\"Fundament 60/80\" werte=\"b=600; h=800\"\n[typ] key=sf40100 name=\"Fundament 40/100\" werte=\"b=400; h=1000\"\n[koerper] form=quader baustoff=stahlbeton teil=\"Fundament\" funktion=loadbearing x=0 y=\"-b/2\" z=0 b=l t=b h=h\n[leistung] key=fundament_beton dmax=600 kurztext=\"Streifenfundament Stb C25/30 XC2, erdgeschalt, b bis 60 cm\" langtext=\"Streifenfundament aus Ortbeton C25/30, Expositionsklasse XC2, Breite bis 60 cm, Höhe bis 1,0 m, gegen Erdreich betoniert, einschließlich Verdichten und Nachbehandeln. Aushub, Sauberkeitsschicht und Bewehrung in gesonderten Positionen.\" gewerk=18331 einheit=m3 bezug=volume stunden=0.9 stoffe=\"1S7bUW0010080100000006:1.03\" funktion=loadbearing quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[menge] key=beton name=\"Beton C25/30\" einheit=m3 formel=\"volumen(stahlbeton)\" baustoff=stahlbeton bezug=volume leistung=fundament_beton dicke=b anzeigen=ja\n[menge] key=stahl name=\"Betonstahl B500\" einheit=t formel=\"volumen(stahlbeton)*0.04\" bezug=steel leistung=1S7bUW0010080200000006\n[notiz] art=stand text=\"Beispiel der Werkbank: Streifenfundament als Linie mit Typen\"\n[notiz] art=offen text=\"Aufwandswert und Bewehrungsgrad 40 kg/m³ prüfen\"\n"
[extdef] key=werk.stuetze version=1 text="SZB 0\n# Beispiel der Skizzeo-Bauteil-Werkbank 0.5\n[bauteil] key=werk.stuetze name=\"Stahlbetonstütze\" mehrzahl=\"Stahlbetonstützen\" genus=f praefix=ST art=column aussen=nein ifc=IfcColumn.COLUMN kg=343 gewerk=18331 version=1 autor=\"Skizzeo\" beschreibung=\"Innenstütze, Rechteckquerschnitt, Fuß auf OK Rohdecke, Kopf unter Decke (als Außenstütze aussen=ja und kg=333)\"\n[bedienung] gruppe=tragwerk einfuegen=punkt drehen=ja\n[hoehe] ab=uk versatz=0\n[param] key=b name=\"Breite\" einheit=mm wert=240 min=200 max=600 gruppe=\"Maße\" zeichnen=ja hilfe=\"Breite der Stütze in Richtung X, vor dem Drehen.\"\n[param] key=d name=\"Tiefe\" einheit=mm wert=240 min=200 max=600 gruppe=\"Maße\" zeichnen=ja hilfe=\"Tiefe der Stütze in Richtung Y, vor dem Drehen.\"\n[typ] key=st24 name=\"Stütze 24/24\" werte=\"b=240; d=240\" standard=ja\n[typ] key=st30 name=\"Stütze 30/30\" werte=\"b=300; d=300\"\n[typ] key=st2440 name=\"Stütze 24/40\" werte=\"b=240; d=400\"\n[wert] key=h name=\"Höhe\" einheit=mm formel=LICHT anzeigen=ja\n[koerper] form=quader baustoff=stahlbeton teil=\"Stütze\" funktion=loadbearing x=0 y=0 z=0 b=b t=d h=h\n[artikel] key=stuetzenschalung name=\"Stützenschalung, Vorhaltung und Verschleiß\" einheit=m2 preis=10 stand=10/2026 quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[leistung] key=stuetze_beton kurztext=\"Stahlbetonstütze C25/30 XC1 betonieren, Querschnitt bis 0,36 m²\" langtext=\"Stahlbetonstütze aus Ortbeton C25/30, Expositionsklasse XC1, Rechteckquerschnitt bis 0,36 m², Höhe bis 3,0 m, einschließlich Verdichten und Nachbehandeln. Bewehrung und Schalung in gesonderten Positionen.\" gewerk=18331 einheit=m3 bezug=volume stunden=1.5 stoffe=\"1S7bUW0010080100000006:1\" funktion=loadbearing quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[leistung] key=stuetze_schalung kurztext=\"Stützenschalung glatt, kein Sichtbeton, Höhe bis 3,0 m\" gewerk=18331 einheit=m2 bezug=formwork stunden=0.8 stoffe=\"stuetzenschalung:1\" quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[menge] key=beton name=\"Beton C25/30\" einheit=m3 formel=\"volumen(stahlbeton)\" baustoff=stahlbeton bezug=volume leistung=stuetze_beton anzeigen=ja\n[menge] key=schalung name=\"Schalung Stütze\" einheit=m2 formel=\"2*(b+d)*h/1000000\" bezug=formwork leistung=stuetze_schalung\n[menge] key=stahl name=\"Betonstahl B500\" einheit=t formel=\"volumen(stahlbeton)*0.15\" bezug=steel leistung=1S7bUW0010080200000006\n[menge] key=stueck name=\"Stütze\" einheit=stk formel=1\n[notiz] art=stand text=\"Startbeispiel der Werkbank: Stütze mit Bedienung, Typen, Funktion, Artikeln, Leistungen und Richtpreis\"\n[notiz] art=offen text=\"Aufwandswerte und Schalungspreis recherchieren, Bewehrungsgrad 150 kg/m³ mit Statik abstimmen\"\n"
[extdef] key=werk.treppe version=2 text="SZB 0\n# Beispiel der Skizzeo-Bauteil-Werkbank 0.5\n[bauteil] key=werk.treppe name=\"Gerade Treppe\" mehrzahl=\"Gerade Treppen\" genus=f praefix=TR art=stair aussen=nein ifc=IfcStair.STRAIGHT_RUN_STAIR kg=351 gewerk=18331 version=2 autor=\"Skizzeo\" beschreibung=\"Einläufige gerade Stahlbetontreppe über ein Geschoss, Ortbeton, Laufplatte und Stufen in einem Körper\"\n[bedienung] gruppe=treppen_gelaender einfuegen=linie laenge=lauf drehen=nein\n[hoehe] ab=uk versatz=0\n[param] key=lauf name=\"Lauflänge\" einheit=mm wert=4200 min=2500 max=6000 zeichnen=ja hilfe=\"Länge im Grundriss von der ersten bis zur letzten Stufenkante.\"\n[param] key=breite name=\"Laufbreite\" einheit=mm wert=1000 min=800 max=1500 gruppe=\"Lauf\" zeichnen=ja hilfe=\"Nutzbare Breite des Laufs, links von der gezeichneten Linie.\"\n[param] key=stufen name=\"Steigungen\" einheit=stk wert=16 min=12 max=20 ganz=ja gruppe=\"Lauf\" hilfe=\"Anzahl der Steigungen über die Geschosshöhe.\"\n[param] key=pd name=\"Dicke\" einheit=mm wert=160 min=120 max=250 gruppe=\"Laufplatte\" hilfe=\"Dicke der Laufplatte senkrecht zur Unterseite.\"\n[typ] key=t16 name=\"16 Steigungen\" werte=\"stufen=16; lauf=4200\" standard=ja\n[typ] key=t17 name=\"17 Steigungen\" werte=\"stufen=17; lauf=4480\"\n[wert] key=s name=\"Steigung\" einheit=mm formel=\"GH/stufen\" anzeigen=ja\n[wert] key=a name=\"Auftritt\" einheit=mm formel=\"lauf/(stufen-1)\" anzeigen=ja\n[wert] key=sm name=\"Schrittmaß\" einheit=mm formel=\"2*s+a\" anzeigen=ja\n[wert] key=w formel=\"atan(s/a)\"\n[wert] key=dv formel=\"pd/cos(w)\"\n# Laufplatte und Stufen sind ein Körper, sonst zeigt die Ansicht die Kante der Laufplatte durch jede Stufe.\n# Ein Umriss hat eine feste Zahl von Punkten, deshalb steht für jede Steigungszahl ein eigener Körper mit wenn.\n# Umriss in der Vorderansicht: unten links, dann Stufe für Stufe Setzstufe und Auftritt, zuletzt senkrecht nach unten.\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==12\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,11*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==13\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,12*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==14\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,13*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==15\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,14*s; 14*a,14*s; 14*a,14*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==16\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,14*s; 14*a,14*s; 14*a,15*s; 15*a,15*s; 15*a,15*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==17\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,14*s; 14*a,14*s; 14*a,15*s; 15*a,15*s; 15*a,16*s; 16*a,16*s; 16*a,16*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==18\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,14*s; 14*a,14*s; 14*a,15*s; 15*a,15*s; 15*a,16*s; 16*a,16*s; 16*a,17*s; 17*a,17*s; 17*a,17*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==19\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,14*s; 14*a,14*s; 14*a,15*s; 15*a,15*s; 15*a,16*s; 16*a,16*s; 16*a,17*s; 17*a,17*s; 17*a,18*s; 18*a,18*s; 18*a,18*s-dv\" von=0 bis=breite\n[koerper] form=prisma ebene=xz baustoff=stahlbeton teil=\"Lauf\" funktion=loadbearing wenn=\"stufen==20\" punkte=\"0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,12*s; 12*a,12*s; 12*a,13*s; 13*a,13*s; 13*a,14*s; 14*a,14*s; 14*a,15*s; 15*a,15*s; 15*a,16*s; 16*a,16*s; 16*a,17*s; 17*a,17*s; 17*a,18*s; 18*a,18*s; 18*a,19*s; 19*a,19*s; 19*a,19*s-dv\" von=0 bis=breite\n[artikel] key=treppenschalung name=\"Treppenschalung, Vorhaltung und Verschleiß\" einheit=m2 preis=14 stand=10/2026 quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[leistung] key=treppe_beton kurztext=\"Treppenlauf Stb C25/30 XC1 betonieren, gerade, mit Stufen\" langtext=\"Gerader Treppenlauf aus Ortbeton C25/30, Expositionsklasse XC1, Laufplatte mit aufbetonierten Stufen, Laufbreite bis 1,5 m, einschließlich Verdichten und Nachbehandeln. Schalung und Bewehrung in gesonderten Positionen.\" gewerk=18331 einheit=m3 bezug=volume stunden=3.5 stoffe=\"1S7bUW0010080100000006:1\" funktion=loadbearing quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[leistung] key=treppe_schalung kurztext=\"Schalung Treppenlauf mit Stufen, glatt, kein Sichtbeton\" gewerk=18331 einheit=m2 bezug=formwork stunden=1.6 stoffe=\"treppenschalung:1\" quelle=\"Beispielwert der Werkbank, nicht recherchiert\" sicherheit=grob\n[menge] key=beton name=\"Beton C25/30\" einheit=m3 formel=\"volumen(stahlbeton)\" baustoff=stahlbeton bezug=volume leistung=treppe_beton anzeigen=ja\n[menge] key=schalung name=\"Schalung Treppe\" einheit=m2 formel=\"(lauf/cos(w)*breite+(stufen-1)*s*breite+2*(lauf*GH/2+lauf/cos(w)*pd))/1000000\" bezug=formwork leistung=treppe_schalung\n[menge] key=stahl name=\"Betonstahl B500\" einheit=t formel=\"volumen(stahlbeton)*0.1\" bezug=steel leistung=1S7bUW0010080200000006\n[menge] key=stueck name=\"Treppe\" einheit=stk formel=1\n[notiz] art=stand text=\"Beispiel der Werkbank: gerade Treppe als Linie mit Lauf-Gruppe, Typen und Schrittmaß; Lauf als ein Prisma je Steigungszahl\"\n[notiz] art=offen text=\"Schalungsmenge vereinfacht, Aufwandswerte recherchieren, Podeste fehlen\"\n"
