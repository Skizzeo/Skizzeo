[bedienung] gruppe=tragwerk einfuegen=rechteck breite=b tiefe=t drehen=ja
[hoehe] ab=uk versatz="-d"
[param] key=b name="Breite" einheit=mm wert=6000 min=1000 max=30000 zeichnen=ja hilfe="Seite in Richtung X, aus der ersten gezogenen Seite."
[param] key=t name="Tiefe" einheit=mm wert=4000 min=1000 max=30000 zeichnen=ja hilfe="Seite in Richtung Y, aus der zweiten gezogenen Seite."
[param] key=d name="Dicke" einheit=mm wert=200 min=150 max=400 gruppe="Maße" hilfe="Plattendicke, Oberkante liegt auf UK Geschoss."
[typ] key=bp20 name="Bodenplatte 20 cm" werte="d=200" standard=ja
[typ] key=bp25 name="Bodenplatte 25 cm" werte="d=250"
[koerper] form=quader baustoff=stahlbeton teil="Platte" funktion=loadbearing x=0 y=0 z=0 b=b t=t h=d
[menge] key=beton name="Beton C25/30" einheit=m3 formel="volumen(stahlbeton)" baustoff=stahlbeton bezug=volume leistung=1S7bUW0010080200000001 dicke=d anzeigen=ja
[menge] key=beton2 name="Beton dick" einheit=m3 formel="volumen(stahlbeton)" leistung=1S7bUW0010080200000001 dicke="d+100"
[menge] key=rand name="Randschalung" einheit=m formel="2*(b+t)/1000" bezug=perimeter leistung=1S7bUW0010080200000005
[menge] key=stahl name="Betonstahl B500" einheit=t formel="volumen(stahlbeton)*0.08" bezug=steel leistung=1S7bUW0010080200000006
