SZB 0
# Beispiel der Skizzeo-Bauteil-Werkbank 0.5
[bauteil] key=werk.treppe name="Gerade Treppe" mehrzahl="Gerade Treppen" genus=f praefix=TR art=stair aussen=nein ifc=IfcStair.STRAIGHT_RUN_STAIR kg=351 gewerk=18331 version=2 autor="Skizzeo" beschreibung="Einläufige gerade Stahlbetontreppe über ein Geschoss, Ortbeton, Laufplatte und Stufen in einem Körper"
[bedienung] gruppe=treppen_gelaender einfuegen=linie laenge=lauf drehen=nein
[hoehe] ab=uk versatz=0
[param] key=lauf name="Lauflänge" einheit=mm wert=4200 min=2500 max=6000 zeichnen=ja hilfe="Länge im Grundriss von der ersten bis zur letzten Stufenkante."
[param] key=breite name="Laufbreite" einheit=mm wert=1000 min=800 max=1500 gruppe="Lauf" zeichnen=ja hilfe="Nutzbare Breite des Laufs, links von der gezeichneten Linie."
[param] key=stufen name="Steigungen" einheit=stk wert=16 min=12 max=20 ganz=ja gruppe="Lauf" hilfe="Anzahl der Steigungen über die Geschosshöhe."
[param] key=pd name="Dicke" einheit=mm wert=160 min=120 max=250 gruppe="Laufplatte" hilfe="Dicke der Laufplatte senkrecht zur Unterseite."
[typ] key=t16 name="16 Steigungen" werte="stufen=16; lauf=4200" standard=ja
[typ] key=t17 name="17 Steigungen" werte="stufen=17; lauf=4480"
[wert] key=s name="Steigung" einheit=mm formel="GH/stufen" anzeigen=ja
[wert] key=a name="Auftritt" einheit=mm formel="lauf/(stufen-1)" anzeigen=ja
[wert] key=sm name="Schrittmaß" einheit=mm formel="2*s+a" anzeigen=ja
[wert] key=w formel="atan(s/a)"
[wert] key=dv formel="pd/cos(w)"
# Laufplatte und Stufen sind ein Körper, sonst zeigt die Ansicht die Kante der Laufplatte durch jede Stufe.
# Ein Umriss hat eine feste Zahl von Punkten, deshalb steht für jede Steigungszahl ein eigener Körper mit wenn.
# Umriss in der Vorderansicht: unten links, dann Stufe für Stufe Setzstufe und Auftritt, zuletzt senkrecht nach unten.
[koerper] form=prisma ebene=xz baustoff=stahlbeton teil="Lauf" funktion=loadbearing wenn="stufen==12" punkte="0,-dv; 0,s; a,s; a,2*s; 2*a,2*s; 2*a,3*s; 3*a,3*s; 3*a,4*s; 4*a,4*s; 4*a,5*s; 5*a,5*s; 5*a,6*s; 6*a,6*s; 6*a,7*s; 7*a,7*s; 7*a,8*s; 8*a,8*s; 8*a,9*s; 9*a,9*s; 9*a,10*s; 10*a,10*s; 10*a,11*s; 11*a,11*s; 11*a,11*s-dv" von=0 bis=breite
