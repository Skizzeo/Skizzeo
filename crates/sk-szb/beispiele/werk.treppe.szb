[artikel] key=treppenschalung name="Treppenschalung, Vorhaltung und Verschleiß" einheit=m2 preis=14 stand=10/2026 quelle="Beispielwert der Werkbank, nicht recherchiert" sicherheit=grob
[leistung] key=treppe_beton kurztext="Treppenlauf Stb C25/30 XC1 betonieren, gerade, mit Stufen" langtext="Gerader Treppenlauf aus Ortbeton C25/30, Expositionsklasse XC1, Laufplatte mit aufbetonierten Stufen, Laufbreite bis 1,5 m, einschließlich Verdichten und Nachbehandeln. Schalung und Bewehrung in gesonderten Positionen." gewerk=18331 einheit=m3 bezug=volume stunden=3.5 stoffe="1S7bUW0010080100000006:1" funktion=loadbearing quelle="Beispielwert der Werkbank, nicht recherchiert" sicherheit=grob
[leistung] key=treppe_schalung kurztext="Schalung Treppenlauf mit Stufen, glatt, kein Sichtbeton" gewerk=18331 einheit=m2 bezug=formwork stunden=1.6 stoffe="treppenschalung:1" quelle="Beispielwert der Werkbank, nicht recherchiert" sicherheit=grob
[menge] key=beton name="Beton C25/30" einheit=m3 formel="volumen(stahlbeton)" baustoff=stahlbeton bezug=volume leistung=treppe_beton anzeigen=ja
[menge] key=schalung name="Schalung Treppe" einheit=m2 formel="(lauf/cos(w)*breite+(stufen-1)*s*breite+2*(lauf*GH/2+lauf/cos(w)*pd))/1000000" bezug=formwork leistung=treppe_schalung
[menge] key=stahl name="Betonstahl B500" einheit=t formel="volumen(stahlbeton)*0.1" bezug=steel leistung=1S7bUW0010080200000006
[menge] key=stueck name="Treppe" einheit=stk formel=1
